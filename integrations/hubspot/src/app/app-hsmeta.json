{
  "uid": "vestiarion_hubspot_app",
  "type": "app",
  "config": {
    "description": "Vestiarion reads your HubSpot companies, contacts and deals so a signed deal becomes a collection schedule and its payments are tracked; when you allow it, it writes each deal's collections back to it.",
    "name": "Vestiarion",
    "distribution": "marketplace",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://www.vestiarion.xyz/api/integrations/hubspot/callback",
        "http://localhost:3000/api/integrations/hubspot/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.companies.read",
        "crm.objects.contacts.read",
        "crm.objects.deals.read"
      ],
      "optionalScopes": [
        "crm.objects.deals.write",
        "crm.schemas.deals.write"
      ],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": [
        "https://api.hubapi.com"
      ],
      "iframe": [],
      "img": []
    },
    "support": {
      "documentationUrl": "https://www.vestiarion.xyz/docs",
      "supportUrl": "https://www.vestiarion.xyz/docs"
    }
  }
}
