# =========================================================================
# Copy to .env.local and fill in. Nothing here is required to run the demo
# in simulate mode except the Supabase values.
# =========================================================================

# --- Database (required) -------------------------------------------------
# Create a project at supabase.com, then run supabase/migrations/0001_init.sql
# in the SQL editor. URL and keys are under Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Required wherever the app runs; as powerful as the service role key. Supabase -> Project Settings -> JWT Keys -> Legacy JWT secret.
SUPABASE_JWT_SECRET=

# The public origin of this deployment (e.g. https://vestiarion.vercel.app).
# Sign-in links are built from it and never from request headers. Required in
# production; defaults to http://localhost:3000 in development.
SITE_URL=

# --- Analytics (production only) ----------------------------------------
# Set to G-SXXT0DB6SW in Vercel Production only. Leave empty elsewhere.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# The workspace name shown in the product is each organization's own
# (`orgs.name`; the founding organization starts as "Vestiarion workspace").
# BUSINESS_NAME no longer changes it and can be left out.

# --- Mutating controls (required outside read-only browsing) -------------
# Generate a long random secret. It is the bearer secret for the cron
# endpoints (POST /api/agent/tick, POST /api/platform/cleanup) and the reset
# endpoint — sent as `Authorization: Bearer <token>`. It no longer unlocks the
# product UI; people sign in and are authorized by organization membership and
# role instead. It does not open the /api/v1 read API either: that uses
# per-workspace API keys, created on a workspace's own Settings page
# (/o/<slug>/settings) — see https://www.vestiarion.xyz/docs/get-started/authentication.
# Never prefix this variable with NEXT_PUBLIC_.
AGENT_API_TOKEN=

# Comma-separated `id:base64(32 bytes)` entries. The first entry encrypts new
# secrets; every entry can decrypt what earlier keys wrote. Generate an entry
# with:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes every stored organization secret unreadable.
VESTIARION_MASTER_KEYS=

# Set to `true` only after enabling the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=

# Production defaults to real wall-clock cycles. Set `simulate` only for a
# disposable demo where each run should advance the numbered day counter.
# CYCLE_CLOCK_MODE=real | simulate

# Destructive reset is always blocked in production unless this exact opt-in
# is present. The reset endpoint also requires {"confirm":"RESET_DEMO_DATA"}.
# ALLOW_DESTRUCTIVE_RESET=true

# --- Agent reasoning (optional) ------------------------------------------
# Three providers are supported. With no key set, every decision falls back
# to the rule-based heuristic in src/lib/agent/orchestrator.ts and the app
# still runs end to end.
#
# Auto-selection prefers Anthropic, then OpenAI, then DeepSeek. Setting
# AGENT_LLM_PROVIDER pins one — and errors rather than silently falling
# through if that provider's key is missing.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# AGENT_LLM_PROVIDER=anthropic | openai | deepseek | heuristic
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_BASE_URL / DEEPSEEK_BASE_URL override the endpoints (proxies, Azure)

# --- Email (optional) ------------------------------------------------------
# Sends member invitations, and the digest that tells members a payment is
# waiting for their decision, through Resend's HTTP API. Without it,
# invitations are not emailed — the inviter is shown the invitation link
# instead, to share directly — and no digest is sent; both work the same
# either way, and a digest that could not be sent is retried, never lost.
RESEND_API_KEY=

# The From address invitation and digest emails are sent with. Optional;
# defaults to Vestiarion <no-reply@vestiarion.xyz>. Only an @vestiarion.xyz
# address is used: any other value is ignored, with a warning, in favour of
# the default.
# EMAIL_FROM=

# --- Compliance (optional) -----------------------------------------------
# Point this at a self-hosted yente base URL (or a full /match/<dataset>
# endpoint) to use live OpenSanctions matching. Hosted OpenSanctions requires
# the optional API key; self-hosted yente commonly does not.
OPENSANCTIONS_API_URL=
OPENSANCTIONS_API_KEY=

# How long a screening stays fresh, in hours. Live mode defaults to 24 hours
# to avoid one network call per counterparty on every short cycle. Bundled
# zero-credential mode defaults to 0 and therefore re-screens every cycle.
# COMPLIANCE_RESCREEN_HOURS=24

# --- Follow-up on frozen decisions (optional) ----------------------------
# An invoice the agent held or asked a question about used to leave the
# decision loop for good. It is now reviewed every cycle: reopened when the
# evidence changed, escalated to a human when nothing changed and time passed.
#
# Days a frozen invoice may sit unchanged before a human is told. A past-due
# invoice escalates immediately regardless. Default 3.
# FOLLOW_UP_STALE_DAYS=3
#
# Days before the same unchanged invoice may be escalated again. Without this
# the agent would raise the identical alert every cycle until nobody read it.
# Default 7.
# FOLLOW_UP_RE_ESCALATE_DAYS=7

# --- Milestone evidence (optional) ---------------------------------------
# Read-only GitHub token used to check whether PR URLs in verification_source
# are merged. Without it, GitHub verification is shown as unavailable and the
# previous verdict is retained; manual human verification remains available.
GITHUB_TOKEN=

# --- Circle / Arc (optional) ---------------------------------------------
# Leave unset to run against the built-in Arc simulator. Set both to move
# real testnet USDC through Circle Developer-Controlled Wallets on Arc.
# Get them from console.circle.com.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional. Discovered from the wallet's own balances when omitted.
CIRCLE_USDC_TOKEN_ID=

# Optional. Arc JSON-RPC URL used to read network fees. Falls back to the
# public https://rpc.testnet.arc.network when unset; a URL with your own
# server token (for example from `arc-canteen rpc-url`) avoids the shared
# endpoint's rate limits. It carries a token, so treat it as a secret.
ARC_RPC_URL=

# Required for EarnKit (USYC) and App Kit (swap/bridge).
# Format: KIT_KEY:<keyId>:<keySecret> — see developers.circle.com/agent-stack
KIT_KEY=

# --- Ledger signing (optional) -------------------------------------------
# Each workspace signs its ledger with its own Ed25519 key, stored encrypted on
# the workspace (under VESTIARION_MASTER_KEYS) and read from there, never from
# this file. LEDGER_SIGNING_KEY is read only by `npm run org:adopt-env`, which
# stores a PKCS8 PEM from here on a workspace that has no key yet (the founding
# workspace, on a fresh database). Once it is stored, remove it: after a
# rotation it is a retired private key, and org:adopt-env refuses it.
LEDGER_SIGNING_KEY=

# Checking a signature needs only the public half. Set this — and not the key
# above — on any host that serves the audit trail without appending to it, so
# that host holds no secret at all. With neither set, the audit page and the
# verify endpoints report the chain as unchecked rather than claiming a
# verdict. The signing key wins when both are present, because a host that can
# sign is the authority on which key signs.
LEDGER_PUBLIC_KEY=

# Rotation is done from Settings → Ledger signing key: an owner rotates, the
# new key is sealed onto the workspace, and the old key's public half is kept
# on the workspace as retired, so everything it signed stays verifiable. The
# ledger records it as a `ledger_key_rotated` entry signed by the new key.
# Nothing here changes. This setting remains only for keys the founding
# workspace's chain retired before workspaces kept their own: their public
# halves, concatenated as one PEM bundle (the same shape as a CA bundle). Never
# put a private key here.
LEDGER_RETIRED_PUBLIC_KEYS=
