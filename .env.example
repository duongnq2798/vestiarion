# =========================================================================
# Copy to .env.local and fill in. Nothing here is required to run the demo
# in simulate mode except the Supabase values.
# =========================================================================

# --- Database (required) -------------------------------------------------
# Create a project at supabase.com, then apply every file in
# supabase/migrations with `npm run db:migrate` (below). URL and keys are under
# Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Read only by `npm run db:migrate` (scripts/migrate.ts), never by the app.
# The project ref and the database password are under Project Settings >
# Database; the region is the pooler's, default us-east-1. SUPABASE_DB_URL, a
# full Postgres connection string, replaces all three when set.
SUPABASE_PROJECT_ID=
SUPABASE_DATABASE_PASSWORD=
# SUPABASE_REGION=us-east-1
# SUPABASE_DB_URL=

# Required wherever the app runs; as powerful as the service role key. Supabase -> Project Settings -> JWT Keys -> Legacy JWT secret.
SUPABASE_JWT_SECRET=

# The public origin of this deployment (e.g. https://vestiarion.vercel.app).
# Sign-in links are built from it and never from request headers. Required in
# production; defaults to http://localhost:3000 in development.
SITE_URL=

# --- Analytics (production only) ----------------------------------------
# Set to G-SXXT0DB6SW in Vercel Production only. Leave empty elsewhere.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# The workspace name shown in the product is each organization's own
# (`orgs.name`; the founding organization starts as "Vestiarion workspace").
# BUSINESS_NAME no longer changes it and can be left out.

# --- Mutating controls (required outside read-only browsing) -------------
# Generate a long random secret. It is the bearer secret for the cron
# endpoints (POST /api/agent/tick, POST /api/platform/cleanup) and the reset
# endpoint — sent as `Authorization: Bearer <token>`. It no longer unlocks the
# product UI; people sign in and are authorized by organization membership and
# role instead. It does not open the /api/v1 read API either: that uses
# per-workspace API keys, created on a workspace's own Settings page
# (/o/<slug>/settings) — see https://www.vestiarion.xyz/docs/get-started/authentication.
# Never prefix this variable with NEXT_PUBLIC_.
AGENT_API_TOKEN=

# Comma-separated `id:base64(32 bytes)` entries. The first entry encrypts new
# secrets; every entry can decrypt what earlier keys wrote. Generate an entry
# with:
#   node -e "console.log('v1:' + require('crypto').randomBytes(32).toString('base64'))"
# Losing it makes every stored organization secret unreadable.
VESTIARION_MASTER_KEYS=

# Set to `true` only after enabling the Google provider in Supabase Auth.
AUTH_GOOGLE_ENABLED=

# Production defaults to real wall-clock cycles. Set `simulate` only for a
# disposable demo where each run should advance the numbered day counter.
# CYCLE_CLOCK_MODE=real | simulate

# Destructive reset is always blocked in production unless this exact opt-in
# is present. The reset endpoint also requires {"confirm":"RESET_DEMO_DATA"}.
# ALLOW_DESTRUCTIVE_RESET=true

# --- Agent reasoning (optional) ------------------------------------------
# Three providers are supported. With no key set, every decision falls back
# to the rule-based heuristic in src/lib/agent/orchestrator.ts and the app
# still runs end to end.
#
# Auto-selection prefers Anthropic, then OpenAI, then DeepSeek. Setting
# AGENT_LLM_PROVIDER pins one — and errors rather than silently falling
# through if that provider's key is missing.
#
# The hosted deployment pins AGENT_LLM_PROVIDER=deepseek: the statements a
# person agrees to before connecting Xero, QuickBooks, Zoho Books, HubSpot,
# Pipedrive or Zoho CRM name DeepSeek as the agent's model provider on the
# hosted service (HOSTED_MODEL_PROVIDER in src/lib/connectors/consent.ts). Changing the
# hosted provider changes what people agreed to, so it needs a new consent
# version. A copy you run yourself may use any provider: the statements say
# DeepSeek only of the hosted service.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# AGENT_LLM_PROVIDER=anthropic | openai | deepseek | heuristic
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-5
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_BASE_URL / DEEPSEEK_BASE_URL override the endpoints (proxies, Azure)
# AGENT_LLM_PRICES prices the model calls a workspace's Settings shows under
# Usage this month: model=input/output in US dollars per million tokens, comma
# separated. Claude's list prices are built in; any other model's cost shows as
# not known without it.
# AGENT_LLM_PRICES=deepseek-chat=0.28/0.42,gpt-5=1.25/10

# --- Email (optional) ------------------------------------------------------
# Sends member invitations, and the digest that tells members a payment is
# waiting for their decision, through Resend's HTTP API. Without it,
# invitations are not emailed — the inviter is shown the invitation link
# instead, to share directly — and no digest is sent; both work the same
# either way, and a digest that could not be sent is retried, never lost.
RESEND_API_KEY=

# The From address invitation and digest emails are sent with. Optional;
# defaults to Vestiarion <no-reply@vestiarion.xyz>. Only an @vestiarion.xyz
# address is used: any other value is ignored, with a warning, in favour of
# the default.
# EMAIL_FROM=

# Where a short note goes when someone asks for a guided setup on /studios:
# the studio's name, how many contractors it pays and how invoices arrive.
# Optional; without it (or without RESEND_API_KEY) no note is sent, and the
# request still lands in the founder dashboard's approval queue.
# GROWTH_INBOUND_NOTIFY_EMAIL=

# --- Telegram bot (optional) ------------------------------------------------
# One bot for the whole deployment: a member connects their own chat from the
# Members page, and it gets the agent's decisions, answers /today, /waiting and
# /ledger, and turns an invoice sent to it into a payable. Set all three, or the
# bot is off. After setting them, register the webhook once:
#   npm run telegram:setup -- https://<your deployment>
# The token @BotFather gives when the bot is made.
TELEGRAM_BOT_TOKEN=
# Telegram sends it back on every webhook call: 16 to 256 of A-Z a-z 0-9 _ -.
# `openssl rand -hex 32` makes one.
TELEGRAM_WEBHOOK_SECRET=
# The bot's username, as @BotFather shows it, with or without the @.
TELEGRAM_BOT_USERNAME=

# --- Slack (optional) -------------------------------------------------------
# One Slack app for the whole deployment, made from integrations/slack/manifest.yaml
# (api.slack.com/apps, Create New App, From a manifest). An owner or admin connects
# a workspace to a channel from Settings; members use /vestiarion. Set all three,
# or Slack is off and its routes answer 404. All three are under Basic Information.
# The app's Client ID: two numbers joined by a dot.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Every request from Slack is checked against it.
SLACK_SIGNING_SECRET=

# --- Invoices by email (optional) -------------------------------------------------
# Resend receives invoices forwarded to each workspace's address, invoices-<code>@<domain>.
# Set all three, or invoices by email are off and /api/email/inbound answers 404.
# Resend's managed <id>.resend.app domain (Emails, Receiving), or a subdomain with Resend's MX record.
INBOUND_EMAIL_DOMAIN=
# The signing secret of the webhook for email.received (Webhooks), whsec_...
RESEND_INBOUND_WEBHOOK_SECRET=
# A key that may read received emails; leave empty when RESEND_API_KEY has full access.
RESEND_RECEIVING_API_KEY=

# --- Compliance (optional) -----------------------------------------------
# The service that screens counterparties' names. A live workspace screens
# only with it: without one, its counterparties stay unscreened, and the agent
# pays them nothing. A sandbox screens against the small bundled list.
#   opensanctions  OpenSanctions' hosted API. Needs SCREENING_API_KEY;
#                  SCREENING_API_URL defaults to https://api.opensanctions.org.
#   yente          A self-hosted yente server at SCREENING_API_URL (a base URL
#                  or a full /match/<dataset> endpoint); a key only if it asks.
# A provider named without what it needs stops the app at start. Check a key
# before you set it in the deployment:
#   npm run screening:check -- "Zenith Trading LLC"
# A changed key is sent only after a redeploy. Then press Check now on
# /admin/screening (platform team) to prove it works on the deployment; see
# "Changing the screening key" in docs/self-hosting.md.
SCREENING_PROVIDER=
SCREENING_API_URL=
SCREENING_API_KEY=
# Older names, read only when none of the three SCREENING_* names is set (the
# two sets never mix): a URL alone screens with OpenSanctions at that address,
# with the key if one is given.
OPENSANCTIONS_API_URL=
OPENSANCTIONS_API_KEY=

# How long a screening stays fresh, in hours. Live mode defaults to 24 hours
# to avoid one network call per counterparty on every short cycle. Bundled
# zero-credential mode defaults to 0 and therefore re-screens every cycle.
# COMPLIANCE_RESCREEN_HOURS=24

# Payout addresses on OFAC's SDN list. A production deployment (VERCEL_ENV=production) reads the Treasury's SDN
# files every 12 hours; anywhere else the snapshot bundled with the code answers. `live` reads them anywhere,
# `snapshot` keeps the snapshot even in production. No key is needed.
# SANCTIONED_WALLETS=live

# --- Follow-up on frozen decisions (optional) ----------------------------
# An invoice the agent held or asked a question about used to leave the
# decision loop for good. It is now reviewed every cycle: reopened when the
# evidence changed, escalated to a human when nothing changed and time passed.
#
# Days a frozen invoice may sit unchanged before a human is told. A past-due
# invoice escalates immediately regardless. Default 3.
# FOLLOW_UP_STALE_DAYS=3
#
# Days before the same unchanged invoice may be escalated again. Without this
# the agent would raise the identical alert every cycle until nobody read it.
# Default 7.
# FOLLOW_UP_RE_ESCALATE_DAYS=7

# --- Milestone evidence (optional) ---------------------------------------
# Read-only GitHub token used to check whether a milestone's pull request (its
# evidence link, kept in verification_source) is merged. With it, a milestone
# added on the Contractors page with a pull request link is checked within a
# minute, and again every cycle until it is merged. Without it, GitHub
# verification is shown as unavailable and the previous verdict is retained,
# and the Contractors form asks for manual verification instead. A token with
# no scopes reads public repositories; give it read access to pull requests
# for private ones.
GITHUB_TOKEN=

# --- GitHub App (optional) ----------------------------------------------------
# One GitHub App for the whole deployment (docs/superpowers/specs/2026-10-04-github-app-design.md §6):
# a workspace installs it on its repositories from Settings, and a milestone paid for a pull request
# there gets a comment on it; private pull requests verify with the installation's token. Repository
# permissions: Pull requests read and write, Issues read, Metadata read. Callback URL: <origin>/api/github/callback,
# with "Request user authorization (OAuth) during installation" and "Redirect on update" ticked. Set all five, or
# GitHub is off and /api/github/* answers 404.
GITHUB_APP_ID=
# The slug in the app's public URL, https://github.com/apps/<slug>; that whole link works too.
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# The .pem file's contents. Newlines may be written as the two characters \n.
GITHUB_APP_PRIVATE_KEY=
# Bounties from a pull request comment (docs/superpowers/specs/2026-10-04-github-bounties-design.md §6): the secret
# set on the app's webhook, which is active with URL <origin>/api/github/webhook and subscribed to "Issue comment"
# and "Pull request" (a merged pull request starts its workspace's cycle).
# Unset, /api/github/webhook answers 404 and /bounty and /payto do nothing.
GITHUB_APP_WEBHOOK_SECRET=

# --- Xero (optional) ------------------------------------------------------------
# One Xero app, of type "Web app", for the whole deployment (docs/superpowers/specs/2026-10-12-xero-connector-design.md):
# an owner or admin connects a workspace to one Xero organisation from Settings, and its approved bills come in for
# review on Bills & receivables. Redirect URI: <origin>/api/integrations/xero/callback. Read-only scopes, asked for by
# the app itself. Set both, or Xero is off and /api/integrations/xero/* answers 404. The sync runs every 15 minutes from
# Supabase Cron (supabase/cron/watches.sql) and needs migration 0101.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=

# --- QuickBooks Online (optional) -----------------------------------------------
# One Intuit app for the whole deployment (docs/superpowers/specs/2026-10-12-quickbooks-connector-design.md): an owner or
# admin connects a workspace to one QuickBooks company from Settings, and its open bills come in for review on Bills &
# receivables. Redirect URI: <origin>/api/integrations/quickbooks/callback; scope com.intuit.quickbooks.accounting. In
# the app's settings: Launch URL <origin>/integrations/quickbooks, Connect/Reconnect URL <origin>/integrations/quickbooks/connect,
# Disconnect URL <origin>/integrations/quickbooks/disconnected. Set both, or QuickBooks is off and
# /api/integrations/quickbooks/* answers 404. QUICKBOOKS_ENVIRONMENT is sandbox (the default) for Development keys and
# sandbox companies, or production for Production keys (Intuit's app assessment first). Needs migrations 0101 and 0102.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=sandbox
# The webhook's verifier token (Intuit Developer, the app's Webhooks page), for <origin>/api/integrations/quickbooks/webhook
# with the CloudEvents payload format, subscribed to Bill, BillPayment and Vendor at least. Unset, the webhook route
# answers 404 and changes come in with the 15-minute sync alone.
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=

# --- Zoho Books and Zoho CRM (optional) -----------------------------------------
# One Zoho "Server-based Applications" client at api-console.zoho.com for the whole deployment
# (docs/superpowers/specs/2026-10-16-zoho-books-connector-design.md): an owner or admin connects a workspace to one Zoho
# Books organization from Settings, and its open bills come in for review on Bills & receivables. Authorized Redirect
# URIs: <origin>/api/integrations/zohobooks/callback (https://www.vestiarion.xyz/... and http://localhost:3000/...). On
# the client's Settings tab, turn on each data center to serve (US, EU, India, Australia, Japan, UK, Canada, Saudi
# Arabia, UAE; not China) and tick "Use the same OAuth credentials for all data centers". Read-only scopes
# ZohoBooks.bills.READ, ZohoBooks.contacts.READ and ZohoBooks.settings.READ, asked for by the app itself. The client id
# is Zoho's 1000. and capital letters and digits. Set both, or Zoho Books is off and /api/integrations/zohobooks/*
# answers 404. No webhook: the sync runs every 15 minutes from Supabase Cron. Needs migration 0122.
ZOHO_BOOKS_CLIENT_ID=
ZOHO_BOOKS_CLIENT_SECRET=
# The same client serves Zoho CRM (docs/superpowers/specs/2026-10-16-zoho-crm-connector-design.md): an owner or admin
# connects a workspace to one Zoho CRM organization from Settings, and its won deals come in under Deals on Bills &
# receivables. Add a second Authorized Redirect URI to the client: <origin>/api/integrations/zohocrm/callback (both
# origins again). Zoho CRM asks for its own read-only scopes (ZohoCRM.modules.deals.READ, ZohoCRM.modules.accounts.READ,
# ZohoCRM.modules.contacts.READ, ZohoCRM.org.READ, ZohoCRM.settings.layouts.READ and ZohoCRM.settings.pipeline.READ)
# and writes nothing to Zoho CRM. Its Developer Edition and sandboxes are not read. Needs migration 0123. To give Zoho
# CRM a client of its own, set both ZOHO_CRM_CLIENT_ID and ZOHO_CRM_CLIENT_SECRET (same id form, same data center
# settings, the redirect URI above); left empty, Zoho CRM uses the Zoho Books pair, and is off when neither is set.
ZOHO_CRM_CLIENT_ID=
ZOHO_CRM_CLIENT_SECRET=

# --- BlindPay bank payouts (optional) ---------------------------------------------
# A vendor's bills paid to its bank account in Mexico over SPEI, through BlindPay
# (docs/superpowers/specs/2026-10-16-bank-payouts-design.md). One BlindPay instance for the whole deployment, made at
# app.blindpay.com: its API key (Settings, API keys) and its id (in_ and 12 letters and digits). In this version use a
# development instance: a workspace is set up with BlindPay's test business values. Add a webhook at
# <origin>/api/integrations/blindpay/webhook with the payout.new, payout.update, payout.complete and payout.partnerFee
# events, and set its signing secret (whsec_...) as BLINDPAY_WEBHOOK_SECRET; without it a payout still settles, on the
# agent's next cycle. Set the key and the id, or bank payouts are off and /api/integrations/blindpay/* answers 404.
# Needs migration 0124.
BLINDPAY_API_KEY=
BLINDPAY_INSTANCE_ID=
BLINDPAY_WEBHOOK_SECRET=
# The network and token BlindPay is paid with, when not the workspace network's own (arc_testnet with BlindPay's USDB
# test token on Arc testnet, arc with USDC on Arc mainnet): lowercase BlindPay network names, such as base_sepolia.
BLINDPAY_NETWORK=
BLINDPAY_TOKEN=

# --- HubSpot (optional) ---------------------------------------------------------
# One HubSpot app on the developer platform, with OAuth and marketplace distribution, for the whole deployment
# (docs/superpowers/specs/2026-10-12-hubspot-connector-design.md): an owner or admin connects a workspace to one
# HubSpot account from Settings, and its won deals come in under Deals on Bills & receivables. The app's config is in
# integrations/hubspot/ and is uploaded with the HubSpot CLI (`hs project upload`, see docs/self-hosting.md); its
# client id and secret are on the app's Auth tab. Redirect URL: <origin>/api/integrations/hubspot/callback. Read-only
# scopes. Set both, or HubSpot is off and /api/integrations/hubspot/* answers 404. Needs migration 0105.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# --- Asana (optional) -----------------------------------------------------------
# One Asana OAuth app for the whole deployment (docs/superpowers/specs/2026-10-14-asana-acceptance-design.md), its
# distribution set to Any workspace: an owner or admin connects a workspace to their Asana from Settings, and a
# milestone is linked to the Asana task its work is delivered in; a person accepts the work once the task is completed.
# Client id and secret are on the app's OAuth page in Asana's developer console. Redirect URL, exactly:
# <origin>/api/integrations/asana/callback. Scopes registered: workspaces:read projects:read tasks:read attachments:read
# stories:read users:read webhooks:read webhooks:write webhooks:delete. Webhooks are made on linked tasks only where the
# origin is https. Set both, or Asana is off and /api/integrations/asana/* answers 404. Needs migration 0115.
ASANA_CLIENT_ID=
ASANA_CLIENT_SECRET=

# --- Linear (optional) ----------------------------------------------------------
# One Linear OAuth application for the whole deployment (docs/superpowers/specs/2026-10-31-linear-acceptance-design.md):
# an owner or admin connects a workspace to a Linear workspace from Settings, and a milestone is linked to the Linear
# issue its work is delivered in; a person accepts the work once the issue is done. Callback URL, exactly:
# <origin>/api/integrations/linear/callback; scope read only. Turn the application's webhooks on, URL
# <origin>/api/integrations/linear/webhook, resource types Issues, Issue attachments, Issue comments and OAuthApp
# revoked, and copy its signing secret here. Set all three, or Linear is off and /api/integrations/linear/* answers 404.
# Needs migration 0147.
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=

# --- Google Sheets (optional) ---------------------------------------------------
# One Google OAuth client (Web application) for the whole deployment
# (docs/superpowers/specs/2026-10-25-close-pack-google-sheets-design.md): an owner or admin connects a workspace to
# one Google account from Settings, and an owner, admin or accountant exports a month's close pack to a spreadsheet
# in its Drive. Enable the Google Sheets API and the Google Drive API; the one scope is
# https://www.googleapis.com/auth/drive.file. Authorized redirect URI, exactly:
# <origin>/api/integrations/googlesheets/callback. Publish the app: in Testing, Google ends refresh tokens after
# 7 days. Set both, or Google Sheets is off and /api/integrations/googlesheets/* answers 404. Needs migration 0145.
GOOGLE_SHEETS_CLIENT_ID=
GOOGLE_SHEETS_CLIENT_SECRET=

# --- Pipedrive (optional) -------------------------------------------------------
# One private app in Pipedrive's Developer Hub for the whole deployment
# (docs/superpowers/specs/2026-10-14-pipedrive-connector-design.md): an owner or admin connects a workspace to one
# Pipedrive company from Settings, and its won deals come in under Deals on Bills & receivables. In the app's OAuth &
# access scopes: Callback URL <origin>/api/integrations/pipedrive/callback, and the scopes base, deals:full,
# contacts:read, deal-fields:full, users:read, recents:read and webhooks:full (Pipedrive grants them all at once, or
# none). Its client id and secret are on the same page. Pipedrive tells <origin>/api/integrations/pipedrive/webhook when
# a deal changes, a webhook Vestiarion registers itself (never from localhost). Set both, or Pipedrive is off and
# /api/integrations/pipedrive/* answers 404. Needs migration 0116 (after 0105 and 0107).
PIPEDRIVE_CLIENT_ID=
PIPEDRIVE_CLIENT_SECRET=

# --- Circle / Arc (optional) ---------------------------------------------
# Leave unset to run against the built-in Arc simulator. Set both to move
# real testnet USDC through Circle Developer-Controlled Wallets on Arc.
# Get them from console.circle.com.
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=

# Optional. Discovered from the wallet's own balances when omitted.
# Arc testnet only: a provider on another network looks USDC up by its contract.
CIRCLE_USDC_TOKEN_ID=

# Optional. Arc JSON-RPC URL used to read network fees. Falls back to the
# public https://rpc.testnet.arc.io when unset; a URL with your own
# server token (for example from `arc-canteen rpc-url`) avoids the shared
# endpoint's rate limits. It carries a token, so treat it as a secret.
ARC_RPC_URL=

# Reserved for EarnKit (USYC) and App Kit (swap/bridge); not read yet, so the
# reserve's yield stays simulated whatever it holds.
# Format: KIT_KEY:<keyId>:<keySecret> — see developers.circle.com/agent-stack
KIT_KEY=

# --- Hosted testnet wallets (optional) -----------------------------------
# The platform's own Circle testnet account, separate from the pair above.
# With both set, Go live offers "Use a Vestiarion testnet wallet": a workspace
# gets wallets on Arc testnet without a Circle account of its own. Only a
# workspace that chose a hosted wallet uses this pair; one with no credentials
# of its own never falls back to it. Unset, the hosted choice is not offered.
HOSTED_CIRCLE_API_KEY=
HOSTED_CIRCLE_ENTITY_SECRET=

# At most this many workspaces may choose a hosted wallet. Default 100; 0
# admits none.
# HOSTED_WORKSPACE_LIMIT=100

# Test USDC for shadow mode (docs/guides/shadow-mode): a wallet on Arc testnet
# in the hosted Circle account above, the pair's one other use, filled from
# TestMint or Circle's faucet. `npm run shadow-float -- setup` makes it and
# prints its id. Unset, the console offers no test USDC. A workspace takes at
# most SHADOW_FLOAT_WEEKLY_LIMIT USDC in any 7 days (default 5000).
SHADOW_FLOAT_WALLET_ID=
# SHADOW_FLOAT_WEEKLY_LIMIT=5000

# --- Payee passkey wallets (optional) --------------------------------------
# A Circle Modular Wallets client key and its client URL, from the Circle
# Console. With both set, a payee paid on Arc testnet can make a wallet with a
# passkey on their payee link, and open it at /wallet. Unset, neither shows.
# The client key is meant for the browser: it names the app to Circle and
# carries no right to move money. Both are built into the pages, so a change
# needs a new build (a redeploy on Vercel). Circle binds a client key to one
# passkey domain, which must match the page's host exactly: production uses a
# key for www.vestiarion.xyz, and local development its own key for localhost.
NEXT_PUBLIC_MODULAR_WALLETS_CLIENT_KEY=
NEXT_PUBLIC_MODULAR_WALLETS_CLIENT_URL=

# --- Stop every payment (optional) -----------------------------------------
# 1, true or yes stops money moving in every workspace: no payment, swap,
# reserve move, Gateway deposit, escrow or spending limit write, and no agent
# cycle. Every page still reads, and each says payments are switched off.
# Unset it and redeploy to turn payments back on. To stop payments without a
# redeploy, run: npm run payments -- off "<reason>" (and -- on to restart).
# PAYMENTS_DISABLED=

# --- Arc mainnet (optional; off unless set) --------------------------------
# 1, true or yes opens Arc mainnet on this deployment, to the email addresses in
# MAINNET_ALLOWLIST only (commas or spaces between them), or to everyone with
# MAINNET_ALLOWLIST=*. An empty allowlist opens it to no one. Such a person can
# create a workspace on Arc mainnet and take it live with a live Circle key
# (LIVE_API_KEY). Unset, every mainnet workspace is held: nothing moves there.
# MAINNET_ENABLED=
# MAINNET_ALLOWLIST=
#
# A workspace on Arc mainnet can instead pay from a wallet its owner holds, such
# as MetaMask, through its spending limit contract. Each such workspace has an
# agent wallet in Vestiarion's own Circle account on Arc mainnet, which holds
# only gas, never a customer's USDC. Both are needed to offer it: a production
# key (LIVE_API_KEY:...) and the entity secret registered for it. Unset, only
# the workspace's own Circle account is offered on Arc mainnet.
# MAINNET_AGENT_CIRCLE_API_KEY=
# MAINNET_AGENT_CIRCLE_ENTITY_SECRET=
# Optional: a keyed Arc mainnet RPC for the server's reads (balances, receipts,
# contracts), in place of the public https://rpc.mainnet.arc.io.
# ARC_MAINNET_RPC_URL=

# The Ethereum node an address field looks up ENS names and Basenames on (docs/superpowers/specs/2026-10-22-ens-address-names-design.md).
# Unset, PublicNode's (https://ethereum-rpc.publicnode.com). A Basename resolves through Coinbase's gateway, the only one the server fetches.
# ENS_RPC_URL=
#
# An owner with no browser wallet can make a passkey wallet the treasury: a
# Circle smart account on Arc mainnet owned by their passkey. It needs a Circle
# mainnet Client Key (Console > Mainnet > API & Client Keys), bound to the site's
# domain. A client key is meant for browsers, so it is public by design: do not
# mark it sensitive. The URL is optional and defaults to Circle's own. Unset, Go
# live offers only a wallet in the owner's browser.
# NEXT_PUBLIC_MODULAR_WALLETS_MAINNET_CLIENT_KEY=
# NEXT_PUBLIC_MODULAR_WALLETS_MAINNET_CLIENT_URL=

# --- Ledger signing (optional) -------------------------------------------
# Each workspace signs its ledger with its own Ed25519 key, stored encrypted on
# the workspace (under VESTIARION_MASTER_KEYS) and read from there, never from
# this file. LEDGER_SIGNING_KEY is read only by `npm run org:adopt-env`, which
# stores a PKCS8 PEM from here on a workspace that has no key yet (the founding
# workspace, on a fresh database). Once it is stored, remove it: after a
# rotation it is a retired private key, and org:adopt-env refuses it.
LEDGER_SIGNING_KEY=

# Not used: each workspace's public key is derived from the signing key stored
# on it, and a workspace's configuration ignores this setting. Leave it empty.
LEDGER_PUBLIC_KEY=

# Rotation is done from Settings → Ledger signing key: an owner rotates, the
# new key is sealed onto the workspace, and the old key's public half is kept
# on the workspace as retired, so everything it signed stays verifiable. The
# ledger records it as a `ledger_key_rotated` entry signed by the new key.
# Nothing here changes. This setting remains only for keys the founding
# workspace's chain retired before workspaces kept their own: their public
# halves, concatenated as one PEM bundle (the same shape as a CA bundle). Never
# put a private key here.
LEDGER_RETIRED_PUBLIC_KEYS=

# --- Tooling (optional) ----------------------------------------------------
# Multiplies the amounts `npm run seed` writes for the demo workspace.
# Defaults to 0.001 when CIRCLE_API_KEY and CIRCLE_ENTITY_SECRET are set, so
# every seeded payment fits inside a testnet faucet grant, and to 1 otherwise.
# SEED_SCALE=1

# Where `npm run docs:screenshots` finds Microsoft Edge, which it drives
# headless. Defaults to the usual Windows install path.
# EDGE_PATH=
